# Copy to .env and edit

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/equity_premier

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRES_HOURS=12

# --- Seeded admin login (used by `python seed.py`) ---
ADMIN_EMAIL=admin@equitypremierhousing.com
ADMIN_PASSWORD=ChangeMe123!

# --- Uploads ---
# Defaults to ../nextjs/public/uploads so Next.js serves images at /uploads/<file>
# UPLOAD_DIR=
UPLOAD_URL_PREFIX=/uploads
MAX_UPLOAD_MB=10

# --- CORS: the Next.js origin ---
CORS_ORIGINS=http://localhost:3000

# --- Railway deployment notes ---
# On Railway these values come from the service Variables tab instead of this file.
# UPLOAD_DIR=/app/uploads
# UPLOAD_URL_PREFIX=https://<your-backend-domain>/uploads
# CORS_ORIGINS=https://<your-frontend-domain>

# --- Backblaze B2 uploads (optional; leave blank to store on local disk) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=Equityp
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_PUBLIC_URL=https://f003.backblazeb2.com/file/Equityp
